# Example variable names only. Never put real secrets in this file.
# Copy to a local ignored .env file only if the selected tooling requires it.

# Backend public project URL (public configuration, not a secret)
BACKEND_URL=

# Public/anon client key if required by the selected backend
BACKEND_ANON_KEY=

# Server-only AI provider key — keep in backend secret storage, never in Flutter
AI_PROVIDER_API_KEY=

# Weather provider configuration, if a provider is selected
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
